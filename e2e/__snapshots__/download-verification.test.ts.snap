exports[`PowerShell does not install a download that doesn't match its checksum: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fnm env | Out-String | Invoke-Expression
$($__out__ = $(fnm --node-dist-mirror=http://localhost:8080/__test__/corrupt install v8.11.3 2>&1 | Select-String 'match its published checksum'); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
if ( "$(fnm ls)" -ne "* system" ) { echo "Expected fnm ls to be * system. Got $(fnm ls)"; exit 1 }"
`;

exports[`PowerShell does not install from a mirror without signatures: PowerShell 1`] = `
